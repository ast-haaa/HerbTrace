# HerbTrace Environment Configuration Template
# Copy this file to .env.local to customize portal destinations and API endpoints

# Portal URLs (Each portal is a separate React application)
# Local development examples:
# VITE_FARMER_PORTAL_URL=http://localhost:5175
# VITE_CONSUMER_PORTAL_URL=http://localhost:5176
# VITE_LAB_PORTAL_URL=http://localhost:5177

# Production path examples (served under reverse proxy or subdomains):
VITE_FARMER_PORTAL_URL=/farmer
VITE_CONSUMER_PORTAL_URL=/consumer
VITE_TRANSPORTER_PORTAL_URL=/transporter
VITE_LAB_PORTAL_URL=/lab

# Spring Boot Backend API Base URL
# Example: http://localhost:8080 or https://api.herbtrace.org
VITE_API_BASE_URL=
